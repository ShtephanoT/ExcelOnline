# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- Microsoft account used by the test (required) -------------------------
# Use a dedicated test account with MFA disabled - see "Known limitations" in README.
MS_EMAIL=your.test.account@example.com
MS_PASSWORD=super-secret-password

# --- Test data (optional, sensible defaults shown) -------------------------
# Cell that receives =TODAY().
EXCEL_TARGET_CELL=A2
# Shortcut that creates a new blank workbook.
EXCEL_NEW_WORKBOOK_URL=https://excel.new

# --- Runtime (optional) ----------------------------------------------------
HEADLESS=true
# chrome | chrome-beta | msedge | chromium ("chromium" uses Playwright's bundled build)
BROWSER_CHANNEL=chrome
SLOW_MO_MS=0
STORAGE_STATE_PATH=.auth/user.json

# Browser clock + UI language. Pinning both makes the rendered date format and
# the expected date deterministic across machines and CI agents.
TIMEZONE_ID=UTC
LOCALE=en-US

# Accept yesterday/tomorrow too (clock skew around midnight). Weakens the check.
ALLOW_MIDNIGHT_TOLERANCE=false

# Timeouts in milliseconds.
APP_LOAD_TIMEOUT_MS=90000
ACTION_TIMEOUT_MS=20000
